# Dockerfile for Raspberry Pi 4
FROM balenalib/raspberrypi4-python:3.9-bullseye

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    unzip \
    pkg-config \
    libopencv-dev \
    python3-opencv \
    libatlas-base-dev \
    libjpeg-dev \
    libtiff5-dev \
    libpng-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libfontconfig1-dev \
    libcairo2-dev \
    libgdk-pixbuf2.0-dev \
    libpango1.0-dev \
    libgtk2.0-dev \
    libgtk-3-dev \
    libhdf5-dev \
    libhdf5-serial-dev \
    libqt5gui5 \
    libqt5webkit5 \
    libqt5test5 \
    && rm -rf /var/lib/apt/lists/*

# Enable camera support
RUN echo "bcm2835-v4l2" >> /etc/modules

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies (with Pi-specific optimizations)
RUN pip install --no-cache-dir \
    --extra-index-url https://www.piwheels.org/simple \
    -r requirements.txt

# Install Pi Camera support
RUN pip install --no-cache-dir picamera2

# Copy application code
COPY src/ ./src/
COPY main.py .
COPY pyproject.toml .

# Create necessary directories
RUN mkdir -p data/models data/cache data/uploads

# Set environment variables for Pi
ENV PYTHONPATH=/app
ENV USE_PI_CAMERA=true
ENV CAMERA_WIDTH=640
ENV CAMERA_HEIGHT=480
ENV FRAME_SKIP=1
ENV PARALLEL_PROCESSING=false

# Download models
RUN python main.py download-models || true

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command (optimized for Pi)
CMD ["python", "main.py", "serve", "--host", "0.0.0.0", "--port", "8000", "--env", "production", "--workers", "1"]